--- !u!114 &1120009031
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1120009029}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f0945c0876dc3e1f6010052c21dc634f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MisionMarte.NPCDialogue
  npcName: Mariale
  isCompanion: 1
  spriteRenderer: {fileID: 418551713}
  ligiSprite: {fileID: 21300000, guid: ec7099de43d7429c5398cf7a4b8f4982, type: 3}
  mariSprite: {fileID: 21300000, guid: 15a5457a24bc5cb62f4951dc847b706e, type: 3}
  visualHeight: 1.5
  introLines:
  - speakerName: '{COMPANERA}'
    nameColor: {r: 0.8, g: 0.6, b: 1, a: 1}
    text: "\xA1{HEROE}! Ya tengo lista la Estaci\xF3n de Reciclaje."
  - speakerName: '{COMPANERA}'
    nameColor: {r: 0.8, g: 0.6, b: 1, a: 1}
    text: "Pero a\xFAn te faltan {FALTAN} residuos y {FUGAS} fugas por cerrar. \xA1Vuelve cuando tengas todo!"
  reminderLines: []
  completeLines:
  - speakerName: '{COMPANERA}'
    nameColor: {r: 0.8, g: 0.6, b: 1, a: 1}
    text: "\xA1Lo lograste, {HEROE}! Clasifiquemos: la botella, la lata y la bolsa van a la caneca BLANCA de aprovechables."
  - speakerName: "{HEROE} (T\xFA)"
    nameColor: {r: 1, g: 0.8, b: 0.3, a: 1}
    text: "\xBFY la pila y el chip? \xBFTambi\xE9n a la blanca?"
  - speakerName: '{COMPANERA}'
    nameColor: {r: 0.8, g: 0.6, b: 1, a: 1}
    text: "No. Son residuos peligrosos y electr\xF3nicos: van a un punto de recolecci\xF3n especial. Nunca a la basura com\xFAn."
  - speakerName: '{COMPANERA}'
    nameColor: {r: 0.8, g: 0.6, b: 1, a: 1}
    text: "Y como cerraste las fugas, la reserva de agua est\xE1 a salvo. Ahora la base puede empezar a purificar agua para la Tierra."
  - speakerName: "{HEROE} (T\xFA)"
    nameColor: {r: 1, g: 0.8, b: 0.3, a: 1}
    text: "\xA1Misi\xF3n 1 completada! Siguiente parada: restaurar los ecosistemas."
  completesLevel: 1
  interactionPrompt: {fileID: 2085683133}

  promptFloating: {fileID: 1316537617}
  title: "TERMINAL DE ENERG\xCDA SOLAR"
  educationalContent: "La base funciona con paneles solares: energ\xEDa limpia que no contamina el aire ni el agua.\n\nBombear y purificar agua gasta mucha energ\xEDa. Por eso, ahorrar agua tambi\xE9n es ahorrar energ\xEDa.\n\n<color=#7CF0FF>Al cerrar esta ventana se activar\xE1 el PUENTE DE ENERG\xCDA para cruzar el cr\xE1ter.</color>"
  activateOnUse:
  - {fileID: 1365771671}
  stateRenderer: {fileID: 2140049894}
  usedSprite: {fileID: 21300000, guid: bd116b4488795357c1bf5222d5da4bd7, type: 3}
  activationMessage: "\xA1Puente de energ\xEDa activado! Ya puedes cruzar."

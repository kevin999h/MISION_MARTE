  m_Script: {fileID: 11500000, guid: 7cf8a8a8686f3469a0da09b1ec9d7c9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MisionMarte.InteractableObject
  promptFloating: {fileID: 1379576213}
  title: "\xBFPOR QU\xC9 RECOGER Y SEPARAR LA BASURA?"
  educationalContent: "Los residuos mal dispuestos contaminan el suelo y el AGUA que necesitamos para vivir.\n\nEn Colombia se separa en 3 canecas:\n<color=#FFFFFF><b>BLANCA</b></color>  \xB7 aprovechables: pl\xE1stico, vidrio, metal, papel y cart\xF3n limpios.\n<color=#6CF07A><b>VERDE</b></color>  \xB7 org\xE1nicos aprovechables: restos de comida y jard\xEDn.\n<color=#AAAAAA><b>NEGRA</b></color>  \xB7 no aprovechables: papel higi\xE9nico, servilletas, empaques sucios.\n\nLas pilas y los aparatos electr\xF3nicos NO van en ninguna caneca: se llevan a puntos de recolecci\xF3n especial."
  activateOnUse: []
  stateRenderer: {fileID: 864745883}
  usedSprite: {fileID: 0}
  activationMessage: 

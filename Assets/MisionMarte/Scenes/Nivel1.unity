--- !u!114 &258950112
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 258950110}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f0945c0876dc3e1f6010052c21dc634f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MisionMarte.NPCDialogue
  npcName: "Comandante Ori\xF3n"
  isCompanion: 0
  spriteRenderer: {fileID: 1111069457}
  ligiSprite: {fileID: 21300000, guid: ec7099de43d7429c5398cf7a4b8f4982, type: 3}
  mariSprite: {fileID: 21300000, guid: 15a5457a24bc5cb62f4951dc847b706e, type: 3}
  visualHeight: 1.5
  introLines:
  - speakerName: "Comandante Ori\xF3n"
    nameColor: {r: 0.55, g: 1, b: 0.65, a: 1}
    text: "\xA1{HEROE}! Qu\xE9 bueno que llegas. La tormenta de polvo dej\xF3 la base marciana hecha un desastre."
  - speakerName: "{HEROE} (T\xFA)"
    nameColor: {r: 1, g: 0.8, b: 0.3, a: 1}
    text: "Vi basura regada por todo el cr\xE1ter... y escuch\xE9 agua goteando."
  - speakerName: "Comandante Ori\xF3n"
    nameColor: {r: 0.55, g: 1, b: 0.65, a: 1}
    text: "Exacto. Hay 5 residuos tirados y 3 tuber\xEDas con fugas. Cada gota que perdemos es agua que no podremos llevar a la Tierra."
  - speakerName: "Comandante Ori\xF3n"
    nameColor: {r: 0.55, g: 1, b: 0.65, a: 1}
    text: "Tu misi\xF3n: recoge los 5 residuos y cierra las 3 fugas con la tecla E. Cuando termines, lleva todo a {COMPANERA} en la Estaci\xF3n de Reciclaje, al final del cr\xE1ter."
  - speakerName: "{HEROE} (T\xFA)"
    nameColor: {r: 1, g: 0.8, b: 0.3, a: 1}
    text: "\xA1Entendido! Base limpia, agua segura."
  - speakerName: "Comandante Ori\xF3n"
    nameColor: {r: 0.55, g: 1, b: 0.65, a: 1}
    text: "Usa ESPACIO para saltar y S mientras corres para deslizarte bajo las tuber\xEDas bajas. Lee el cartel de al lado antes de salir. \xA1Suerte!"
  reminderLines:
  - speakerName: "Comandante Ori\xF3n"
    nameColor: {r: 0.55, g: 1, b: 0.65, a: 1}
    text: "Todav\xEDa faltan {FALTAN} residuos y {FUGAS} fugas por cerrar."
  - speakerName: "Comandante Ori\xF3n"
    nameColor: {r: 0.55, g: 1, b: 0.65, a: 1}
    text: "Pista: busca arriba de las plataformas, dentro del t\xFAnel y en la meseta alta."
  completeLines:
  - speakerName: "Comandante Ori\xF3n"
    nameColor: {r: 0.55, g: 1, b: 0.65, a: 1}
    text: "\xA1Excelente trabajo, {HEROE}! La base ya no pierde agua."
  - speakerName: "Comandante Ori\xF3n"
    nameColor: {r: 0.55, g: 1, b: 0.65, a: 1}
    text: "Ve con {COMPANERA} a la Estaci\xF3n de Reciclaje para clasificar los residuos y cerrar la misi\xF3n."
  completesLevel: 0
  interactionPrompt: {fileID: 1325120288}
